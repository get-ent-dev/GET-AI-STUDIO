// lib/studio-store.ts
import { create } from 'zustand';

export interface MessagePart {
  text?: string;
  inlineData?: {
    mimeType: string;
    data: string; // Base64
  };
}

export interface StudioMessage {
  id: string;
  role: 'user' | 'model';
  parts: MessagePart[];
  telemetry?: {
    ttftMs: number;
    totalMs: number;
    tokensPerSecond: number;
    tokenCount: number;
    cost: number;
  };
}

export interface StudioConfig {
  model: string;
  temperature: number;
  topP: number;
  topK: number;
  maxOutputTokens: number;
  systemInstruction: string;
  groundingSearch: boolean;
  codeExecution: boolean;
  responseMimeType: string;
  responseSchemaText: string;
}

interface StudioStore {
  config: StudioConfig;
  messages: StudioMessage[];
  isGenerating: boolean;
  activeTab: 'chat' | 'arena' | 'evals';
  arenaModel: string;
  
  setConfig: (patch: Partial<StudioConfig>) => void;
  addMessage: (msg: StudioMessage) => void;
  updateLastModelMessage: (text: string, telemetry?: StudioMessage['telemetry']) => void;
  clearMessages: () => void;
  setIsGenerating: (loading: boolean) => void;
  setActiveTab: (tab: 'chat' | 'arena' | 'evals') => void;
  setArenaModel: (model: string) => void;
}

export const useStudioStore = create<StudioStore>((set) => ({
  config: {
    model: 'gemini-2.0-flash',
    temperature: 0.7,
    topP: 0.95,
    topK: 40,
    maxOutputTokens: 8192,
    systemInstruction: '',
    groundingSearch: false,
    codeExecution: false,
    responseMimeType: 'text/plain',
    responseSchemaText: '',
  },
  messages: [],
  isGenerating: false,
  activeTab: 'chat',
  arenaModel: 'gemini-1.5-pro',

  setConfig: (patch) => set((s) => ({ config: { ...s.config, ...patch } })),
  addMessage: (msg) => set((s) => ({ messages: [...s.messages, msg] })),
  updateLastModelMessage: (text, telemetry) =>
    set((s) => {
      const msgs = [...s.messages];
      const last = msgs[msgs.length - 1];
      if (last && last.role === 'model') {
        last.parts = [{ text }];
        if (telemetry) last.telemetry = telemetry;
      }
      return { messages: msgs };
    }),
  clearMessages: () => set({ messages: [] }),
  setIsGenerating: (isGenerating) => set({ isGenerating }),
  setActiveTab: (activeTab) => set({ activeTab }),
  setArenaModel: (arenaModel) => set({ arenaModel }),
}));

2. Backend Streaming API Route (app/api/generate/route.ts)

Interacts with the Google Gen AI API, supporting tools (Search Grounding, Code
Execution), JSON Schema enforcement, and Server-Sent Events (SSE).

// app/api/generate/route.ts
import { NextRequest, NextResponse } from 'next/server';
import { GoogleGenAI } from '@google/genai';

export const runtime = 'nodejs';

export async function POST(req: NextRequest) {
  try {
    const { 
      config, 
      messages, 
      apiKey 
    } = await req.json();

    const client = new GoogleGenAI({ 
      apiKey: apiKey || process.env.GEMINI_API_KEY 
    });

    // Build Tool Array
    const tools: any[] = [];
    if (config.groundingSearch) {
      tools.push({ googleSearch: {} });
    }
    if (config.codeExecution) {
      tools.push({ codeExecution: {} });
    }

    // Build Structured Output Config
    let responseSchema = undefined;
    if (config.responseMimeType === 'application/json' && config.responseSchemaText) {
      try {
        responseSchema = JSON.parse(config.responseSchemaText);
      } catch (e) {
        return NextResponse.json({ error: 'Invalid JSON Schema syntax.' }, { status: 400 });
      }
    }

    // Map conversation turns to Gemini API shape
    const contents = messages.map((m: any) => ({
      role: m.role,
      parts: m.parts.map((p: any) => {
        if (p.inlineData) {
          return {
            inlineData: {
              mimeType: p.inlineData.mimeType,
              data: p.inlineData.data,
            },
          };
        }
        return { text: p.text || '' };
      }),
    }));

    const systemInstruction = config.systemInstruction ? {
      role: 'system',
      parts: [{ text: config.systemInstruction }]
    } : undefined;

    // Call streaming API
    const responseStream = await client.models.generateContentStream({
      model: config.model,
      contents,
      config: {
        temperature: config.temperature,
        topP: config.topP,
        topK: config.topK,
        maxOutputTokens: config.maxOutputTokens,
        systemInstruction,
        tools: tools.length > 0 ? tools : undefined,
        responseMimeType: config.responseMimeType,
        responseSchema,
      },
    });

    const encoder = new TextEncoder();
    const customReadable = new ReadableStream({
      async start(controller) {
        try {
          for await (const chunk of responseStream) {
            const text = chunk.text || '';
            // Send SSE payload
            controller.enqueue(
              encoder.encode(`data: ${JSON.stringify({ text, usage: chunk.usageMetadata })}\n\n`)
            );
          }
          controller.enqueue(encoder.encode('data: [DONE]\n\n'));
          controller.close();
        } catch (err: any) {
          controller.error(err);
        }
      },
    });

    return new Response(customReadable, {
      headers: {
        'Content-Type': 'text/event-stream',
        'Cache-Control': 'no-cache',
        'Connection': 'keep-alive',
      },
    });
  } catch (error: any) {
    console.error('Generation Error:', error);
    return NextResponse.json({ error: error.message || 'Generation failed' }, { status: 500 });
  }
}

