export const ParameterPanel = () => {
  const { config, setConfig } = useStudioStore();
  const [jsonExample, setJsonExample] = useState('');

  // Enhanced Feature: Infer OpenAPI schema automatically from sample JSON
  const inferSchemaFromJson = () => {
    try {
      const parsed = JSON.parse(jsonExample);
      const generateType = (val: any): any => {
        if (Array.isArray(val)) {
          return { type: 'ARRAY', items: generateType(val[0] || 'string') };
        }
        if (val !== null && typeof val === 'object') {
          const properties: Record<string, any> = {};
          Object.keys(val).forEach((k) => (properties[k] = generateType(val[k])));
          return { type: 'OBJECT', properties };
        }
        if (typeof val === 'number') return { type: 'NUMBER' };
        if (typeof val === 'boolean') return { type: 'BOOLEAN' };
        return { type: 'STRING' };
      };

      const schema = generateType(parsed);
      setConfig({ 
        responseMimeType: 'application/json',
        responseSchemaText: JSON.stringify(schema, null, 2) 
