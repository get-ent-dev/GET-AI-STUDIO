4. Interactive Workspace & Telemetry (components/ChatCanvas.tsx)

Renders the system prompt, chat history, multimodal attachments, real-time token
tracking, and latency benchmarks.

// components/ChatCanvas.tsx
'use client';
import React, { useState, useRef } from 'react';
import { useStudioStore } from '@/lib/studio-store';
import { Play, Square, Paperclip, Sparkles, Clock, Zap, DollarSign } from 'lucide-react';

export const ChatCanvas = () => {
  const { 
    config, 
    setConfig, 
    messages, 
    addMessage, 
    updateLastModelMessage, 
    isGenerating, 
    setIsGenerating 
  } = useStudioStore();

  const [input, setInput] = useState('');
  const [attachment, setAttachment] = useState<{ mimeType: string; data: string; preview: string } | null>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);

  // File Upload Handler (Base64)
  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = () => {
      const base64Data = (reader.result as string).split(',')[1];
      setAttachment({
        mimeType: file.type,
        data: base64Data,
        preview: URL.createObjectURL(file),
      });
    };
    reader.readAsDataURL(file);
  };

  const handleRun = async () => {
    if ((!input.trim() && !attachment) || isGenerating) return;

    const userParts: any[] = [];
    if (attachment) {
      userParts.push({
        inlineData: {
          mimeType: attachment.mimeType,
          data: attachment.data,
        },
      });
    }
    if (input.trim()) {
      userParts.push({ text: input });
    }

    const userMessage = {
      id: crypto.randomUUID(),
      role: 'user' as const,
      parts: userParts,
    };

    const initialModelMessage = {
      id: crypto.randomUUID(),
      role: 'model' as const,
      parts: [{ text: '' }],
    };

    addMessage(userMessage);
    addMessage(initialModelMessage);
    setInput('');
    setAttachment(null);
    setIsGenerating(true);

    const startTime = performance.now();
    let firstTokenTime: number | null = null;
    let accumulatedText = '';

    try {
      const response = await fetch('/api/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          config,
          messages: [...messages, userMessage],
        }),
      });

      if (!response.body) throw new Error('Readable stream not supported');

      const reader = response.body.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { value, done } = await reader.read();
        if (done) break;

        const raw = decoder.decode(value);
        const lines = raw.split('\n');

        for (const line of lines) {
          if (line.startsWith('data: ')) {
            const dataStr = line.replace('data: ', '').trim();
            if (dataStr === '[DONE]') continue;

            try {
              const parsed = JSON.parse(dataStr);
              if (!firstTokenTime) {
                firstTokenTime = performance.now();
              }
              if (parsed.text) {
                accumulatedText += parsed.text;
                updateLastModelMessage(accumulatedText);
              }
            } catch (err) {
              // Partial stream chunk
            }
          }
        }
      }

      // Final Telemetry Calculation
      const totalTime = performance.now() - startTime;
      const ttft = firstTokenTime ? firstTokenTime - startTime : totalTime;
      const approxTokens = Math.ceil(accumulatedText.length / 4);
      const tps = (approxTokens / (totalTime / 1000));
      // Approx cost based on Gemini 2.0 Flash: $0.10 per 1M input, $0.40 per 1M output
      const cost = (approxTokens / 1_000_000) * 0.40;

      updateLastModelMessage(accumulatedText, {
        ttftMs: Math.round(ttft),
        totalMs: Math.round(totalTime),
        tokensPerSecond: Math.round(tps * 10) / 10,
        tokenCount: approxTokens,
        cost,
      });

    } catch (err: any) {
      updateLastModelMessage(`Error: ${err.message}`);
    } finally {
      setIsGenerating(false);
    }
  };

  return (
    <div className="flex-1 flex flex-col h-full bg-zinc-900 text-zinc-100 overflow-hidden">
      {/* System Instruction (Collapsible/Editable) */}
      <div className="p-3 bg-zinc-950 border-b border-zinc-800">
        <label className="text-xs uppercase tracking-wide font-medium text-zinc-400 block mb-1">
          System Instructions
        </label>
        <textarea
          value={config.systemInstruction}
          onChange={(e) => setConfig({ systemInstruction: e.target.value })}
          placeholder="Optional guidelines for how the model should behave, tone, format constraints..."
          rows={2}
          className="w-full bg-zinc-900/60 border border-zinc-800 rounded p-2 text-xs text-zinc-200 resize-none focus:outline-none focus:border-zinc-600"
        />
      </div>

      {/* Message Canvas */}
      <div className="flex-1 p-6 overflow-y-auto space-y-6">
        {messages.map((m) => (
          <div
            key={m.id}
            className={`flex flex-col ${
              m.role === 'user' ? 'items-end' : 'items-start'
            }`}
          >
            <div
              className={`max-w-2xl rounded-lg p-4 text-sm ${
                m.role === 'user'
                  ? 'bg-blue-600/20 border border-blue-500/30 text-blue-100'
                  : 'bg-zinc-800/80 border border-zinc-700/60 text-zinc-200'
              }`}
            >
              <div className="text-xs font-semibold text-zinc-400 mb-2 uppercase">
                {m.role === 'user' ? 'User' : config.model}
              </div>

              {/* Render User Attachments */}
              {m.parts.map((p, idx) => (
                <div key={idx}>
                  {p.inlineData && (
                    <div className="mb-2">
                      {p.inlineData.mimeType.startsWith('image/') ? (
                        <img
                          src={`data:${p.inlineData.mimeType};base64,${p.inlineData.data}`}
                          className="max-h-48 rounded border border-zinc-700"
                          alt="Multimodal attachment"
                        />
                      ) : (
                        <div className="bg-zinc-900 p-2 rounded text-xs font-mono">
                          Document ({p.inlineData.mimeType})
                        </div>
                      )}
                    </div>
                  )}
                  {p.text && <div className="whitespace-pre-wrap">{p.text}</div>}
                </div>
              ))}

              {/* Enhanced Feature: Real-time Telemetry Metrics Pill */}
              {m.telemetry && (
                <div className="mt-3 pt-2 border-t border-zinc-700 flex flex-wrap gap-4 text-[10px] text-zinc-400 font-mono">
                  <span className="flex items-center gap-1">
                    <Clock className="w-3 h-3 text-emerald-400" /> TTFT: {m.telemetry.ttftMs}ms
                  </span>
                  <span className="flex items-center gap-1">
                    <Zap className="w-3 h-3 text-amber-400" /> Speed: {m.telemetry.tokensPerSecond} tps
                  </span>
                  <span className="flex items-center gap-1">
                    <Sparkles className="w-3 h-3 text-blue-400" /> Output: {m.telemetry.tokenCount} tokens
                  </span>
                  <span className="flex items-center gap-1">
                    <DollarSign className="w-3 h-3 text-purple-400" /> Cost: ${m.telemetry.cost.toFixed(6)}
                  </span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      {/* Input Bar */}
      <div className="p-4 bg-zinc-950 border-t border-zinc-800">
        {attachment && (
          <div className="flex items-center gap-2 mb-2 bg-zinc-900 w-fit px-2 py-1 rounded text-xs border border-zinc-800">
            <span className="text-zinc-400">Attached: {attachment.mimeType}</span>
            <button
              onClick={() => setAttachment(null)}
              className="text-red-400 hover:text-red-300 ml-2"
            >
              ×
            </button>
          </div>
        )}

        <div className="flex items-center gap-2">
          <input
            type="file"
            ref={fileInputRef}
            onChange={handleFileUpload}
            className="hidden"
            accept="image/*,application/pdf"
          />
          <button
            onClick={() => fileInputRef.current?.click()}
            className="p-2 bg-zinc-900 border border-zinc-800 hover:bg-zinc-800 rounded-md text-zinc-400"
            title="Attach multimodal image or file"
          >
            <Paperclip className="w-4 h-4" />
          </button>

          <textarea
            value={input}
            onChange={(e) => setInput(e.target.value)}
            onKeyDown={(e) => {
              if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                handleRun();
              }
            }}
            placeholder="Type your prompt here... (Shift+Enter for new line)"
            rows={1}
            className="flex-1 bg-zinc-900 border border-zinc-800 rounded-md px-3 py-2 text-sm text-zinc-100 focus:outline-none focus:border-zinc-700 resize-none"
          />

          <button
            onClick={handleRun}
            disabled={isGenerating}
            className="px-4 py-2 bg-blue-600 hover:bg-blue-500 disabled:bg-zinc-800 text-white rounded-md text-sm font-medium flex items-center gap-2"
          >
            {isGenerating ? (
              <>
                <Square className="w-4 h-4 animate-pulse" /> Stop
              </>
            ) : (
              <>
                <Play className="w-4 h-4 fill-white" /> Run
              </>
            )}
          </button>
        </div>
      </div>
    </div>
  );
};

5. Multi-Language Code Exporter (components/GetCodeModal.tsx)

Mirrors Google AI Studio’s Get Code button, dynamically generating live,
copy-pasteable snippets for Python (@google/genai), TypeScript, and cURL.

// components/GetCodeModal.tsx
'use client';
import React, { useState } from 'react';
import { useStudioStore } from '@/lib/studio-store';
import { Copy, Check, Code2 } from 'lucide-react';

export const GetCodeModal = ({ isOpen, onClose }: { isOpen: boolean; onClose: () => void }) => {
  const { config, messages } = useStudioStore();
  const [lang, setLang] = useState<'python' | 'ts' | 'curl'>('python');
  const [copied, setCopied] = useState(false);

  if (!isOpen) return null;

  // Code Generation Templates
  const getPythonSnippet = () => {
    return `from google import genai
from google.genai import types

client = genai.Client()

response = client.models.generate_content(
    model="${config.model}",
    contents=${JSON.stringify(messages.map(m => m.parts.map(p => p.text).join(' ')), null, 4)},
    config=types.GenerateContentConfig(
        temperature=${config.temperature},
        top_p=${config.topP},
        top_k=${config.topK},
        max_output_tokens=${config.maxOutputTokens},
        ${config.systemInstruction ? `system_instruction="${config.systemInstruction}",` : ''}
        ${config.groundingSearch ? `tools=[{"google_search": {}}],` : ''}
        ${config.responseMimeType === 'application/json' ? `response_mime_type="application/json",` : ''}
    )
)

print(response.text)
`;
  };

  const getTypescriptSnippet = () => {
    return `import { GoogleGenAI } from '@google/genai';

const client = new GoogleGenAI();

async function run() {
  const response = await client.models.generateContent({
    model: '${config.model}',
    contents: ${JSON.stringify(messages.map(m => ({ role: m.role, parts: m.parts })), null, 2)},
    config: {
      temperature: ${config.temperature},
      topP: ${config.topP},
      topK: ${config.topK},
      maxOutputTokens: ${config.maxOutputTokens},
      ${config.systemInstruction ? `systemInstruction: "${config.systemInstruction}",` : ''}
      ${config.groundingSearch ? `tools: [{ googleSearch: {} }],` : ''}
    }
  });

  console.log(response.text);
}

run();
`;
  };

  const codeSnippets = {
    python: getPythonSnippet(),
    ts: getTypescriptSnippet(),
    curl: `curl "https://generativelanguage.googleapis.com/v1beta/models/${config.model}:generateContent?key=$GEMINI_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "contents": ${JSON.stringify(messages.map(m => ({ role: m.role, parts: m.parts })))},
    "generationConfig": {
      "temperature": ${config.temperature},
      "maxOutputTokens": ${config.maxOutputTokens}
    }
  }'`,
  };

  const handleCopy = () => {
    navigator.clipboard.writeText(codeSnippets[lang]);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  return (
    <div className="fixed inset-0 bg-black/70 flex items-center justify-center z-50 p-4">
      <div className="bg-zinc-950 border border-zinc-800 rounded-xl w-full max-w-3xl overflow-hidden flex flex-col max-h-[85vh]">
        <div className="flex items-center justify-between p-4 border-b border-zinc-800">
          <div className="flex items-center gap-2">
            <Code2 className="w-5 h-5 text-blue-400" />
            <h3 className="font-medium text-zinc-100">Get Code</h3>
          </div>
          <button onClick={onClose} className="text-zinc-400 hover:text-zinc-200">✕</button>
        </div>

        {/* Tab Selector */}
        <div className="flex border-b border-zinc-800 bg-zinc-900/50 px-4">
          {(['python', 'ts', 'curl'] as const).map((tab) => (
            <button
              key={tab}
              onClick={() => setLang(tab)}
              className={`py-2 px-4 text-xs font-semibold uppercase border-b-2 transition ${
                lang === tab
                  ? 'border-blue-500 text-blue-400'
                  : 'border-transparent text-zinc-400 hover:text-zinc-200'
              }`}
            >
              {tab === 'python' ? 'Python (SDK)' : tab === 'ts' ? 'TypeScript' : 'cURL'}
            </button>
          ))}
        </div>

        {/* Code Display */}
        <div className="relative flex-1 p-4 bg-zinc-900 overflow-auto">
          <button
            onClick={handleCopy}
            className="absolute top-6 right-6 p-2 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded border border-zinc-700 flex items-center gap-1.5 text-xs"
          >
            {copied ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />}
            {copied ? 'Copied!' : 'Copy Code'}
          </button>
          <pre className="font-mono text-xs text-zinc-300 leading-relaxed overflow-x-auto">
            {codeSnippets[lang]}
          </pre>
        </div>
      </div>
    </div>
  );
};

